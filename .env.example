# Copy to .env and fill in. The .env file is never committed.
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_SERIALIZE=false
# Optional override. By default the service uses data/latest.json after an import.
# CATALOG_PATH=data/catalog.sqlite3
IMAGE_DIR=data/images
MAX_UPLOAD_BYTES=8000000
OCR_MIN_CONFIDENCE=0.4
HOST=127.0.0.1
PORT=8000

# Failure alerts. Create the bot with @BotFather, then message it once and read
# your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
